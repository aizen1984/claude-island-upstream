  "combinationRules": {
    "_description": "处理非显而易见的组合关键词场景（精简版：仅保留模型不易自主判断的 5 条核心规则）",
    "_implementedBy": "claude-understanding",
    "_implementationNote": "组合规则依赖 Claude 自身理解力执行，非 Hook 运行时强制。Claude 读取此配置后按 resolution 类型（clarify/auto/chain）自主决策。",
    "rules": [
      {
        "id": "design-plan-combo",
        "pattern": "(规划|计划).*(设计|方案|文档)|(设计|方案|文档).*(规划|计划)",
        "resolution": "clarify",
        "clarifyQuestion": "您是需要**设计文档**（PRD/技术方案），还是需要**任务规划**（可执行任务清单）？",
        "options": [
          {
            "label": "设计文档",
            "skill": "cc-design"
          },
          {
            "label": "任务规划",
            "skill": "cc-planner"
          },
          {
            "label": "先设计后规划",
            "sequence": [
              "cc-design",
              "cc-planner"
            ]
          }
        ]
      },
      {
        "id": "design-implement-combo",
        "pattern": "(设计|方案).*(实现|开发|编写)|(实现|开发).*(设计|方案)",
        "resolution": "chain",
        "chainSequence": [
          "cc-design",
          "cc-planner",
          "cc-code-writer"
        ],
        "_reason": "完整开发流程：设计文档 -> 任务拆解 -> 代码实现",
        "_note": "chain 链首已执行 cc-design 时，planner 应跳过内部 DESIGN/DESIGN-REVIEW 子阶段，避免重复设计"
      },
      {
        "id": "code-review-combo",
        "pattern": "(写代码|实现|开发).*(审查|review|检查)|(审查|review|检查).*(写代码|实现|开发)",
        "resolution": "clarify",
        "clarifyQuestion": "您是需要**编写代码**（含内置审查），还是需要**审查已有代码**？",
        "options": [
          {
            "label": "编写代码",
            "skill": "cc-code-writer"
          },
          {
            "label": "审查代码",
            "skill": "cc-code-reviewer"
          },
          {
            "label": "先写后审",
            "sequence": [
              "cc-code-writer",
              "cc-code-reviewer"
            ]
          }
        ]
      },
      {
        "id": "tdd-code-combo",
        "pattern": "(TDD|测试驱动|先写测试).*(写代码|实现|开发|帮我写|帮我实现)|(写代码|实现|开发|帮我写|帮我实现).*(TDD|测试驱动|先写测试)",
        "resolution": "auto",
        "autoSelect": [
          "cc-tdd",
          "cc-code-writer"
        ],
        "_reason": "TDD + 编码意图明确指向两者同时激活"
      },
      {
        "id": "adversarial-review-combo",
        "pattern": "(验证|质疑|挑战).*(审查|review)|(审查|review).*(验证|质疑|挑战)",
        "resolution": "clarify",
        "clarifyQuestion": "您是需要**对已有结论进行对抗验证**，还是需要**独立代码审查**？",
        "options": [
          {
            "label": "对抗验证",
            "skill": "cc-adversarial"
          },
          {
            "label": "代码审查",
            "skill": "cc-code-reviewer"
          }
        ]
      },
      {
        "id": "ob-summary-time-combo",
        "pattern": "(总结|汇总|聚合).*(这周|本周|上周|这月|本月|上月|最近几天)|(这周|本周|上周|这月|本月|上月).*(总结|回顾|汇总|聚合)",
        "resolution": "auto",
        "autoSelect": [
          "cc-ob-aggregate"
        ],
        "_reason": "含时间范围的总结 → 周期性聚合（非单次会话）"
      },
      {
        "id": "ob-summary-session-combo",
        "pattern": "(总结|记录|保存).*(今天的工作|刚才|这次会话|本次会话|当前会话)|(今天|本次|刚才).*(会话|工作).*(总结|记录|保存)",
        "resolution": "auto",
        "autoSelect": [
          "cc-ob-session-log"
        ],
        "_reason": "聚焦当前会话的总结 → 会话日志"
      },
      {
        "id": "ob-review-knowledge-combo",
        "pattern": "(复盘|回顾).*(知识|领域|主题|关联|笔记)|(知识|领域|主题).*(复盘|回顾|探索)",
        "resolution": "clarify",
        "clarifyQuestion": "您是需要**发现笔记间的隐藏关联**（主题聚类），还是需要**定期知识回顾**（周月报）？",
        "options": [
          {
            "label": "发现隐藏关联",
            "skill": "cc-ob-spark"
          },
          {
            "label": "定期回顾",
            "skill": "cc-ob-aggregate"
          }
        ]
      },
      {
        "id": "ob-record-vs-sync-combo",
        "pattern": "(记录|写入|保存).*(会话|工作).*(知识库|vault)|(知识库|vault).*(记录|保存).*(会话|工作)",
        "resolution": "clarify",
        "clarifyQuestion": "您是需要**记录会话元数据**（做了什么），还是需要**提炼会话知识**（发现了什么）？",
        "options": [
          {
            "label": "记录行为",
            "skill": "cc-ob-session-log"
          },
          {
            "label": "提炼知识",
            "skill": "cc-kb-sync"
          }
        ]
      }
    ]
  },
  "dataContracts": {
    "_description": "Skill 间数据传递格式的唯一定义位置",
    "_source": "shared-rules/data-contracts.md",
    "registeredContracts": [
      "planner → code-writer/work-mode",
      "code-writer/work-mode → code-reviewer",
      "code-reviewer → code-writer/work-mode",
      "cc-api-analyzer → cc-diagram",
      "design ↔ planner",
      "design → cc-diagram",
      "design → cc-api-analyzer",
      "user → cc-sql",
      "user → cc-cfg",
      "user → cc-sls-query",
      "user → cc-troubleshoot",
      "cc-tdd ↔ code-writer/work-mode",
      "user → cc-adversarial",
      "cc-adversarial → adversarial-verification.md",
      "cc-ob-session-log → vault/daily-notes/",
      "cc-ob-spark → vault/spark-reports/",
      "cc-ob-aggregate → vault/weekly-reviews/ | vault/monthly-reviews/",
      "cc-ob-session-log → cc-ob-aggregate",
      "vault/daily-notes → cc-ob-spark (optional)"
    ]
  },
  "_forbiddenCombinations_implementedBy": "claude-understanding",
  "_forbiddenCombinations_note": "禁止组合依赖 Claude 自身理解力执行，非 Hook 运行时强制。Claude 读取此配置后主动阻止禁止链路。",
  "forbiddenCombinations": [
    {
      "id": "no-design-to-writer-direct",
      "from": "cc-design",
      "to": "cc-code-writer",
      "reason": "设计文档必须先经 planner 拆解为任务",
      "alternative": "cc-design → cc-planner → cc-code-writer"
    },
    {
      "id": "no-workmode-nesting",
      "from": "cc-work-mode",
      "to": "cc-work-mode",
      "reason": "嵌套并发导致资源竞争",
      "alternative": "由 cc-planner 统一调度"
    },
    {
      "id": "no-planner-unreviewed-to-execute",
      "from": "cc-planner",
      "to": "EXECUTE",
      "condition": "plan 未经用户确认",
      "reason": "计划必须经用户评审确认后才能进入执行阶段",
      "alternative": "cc-planner.PLAN → 用户确认 → EXECUTE"
    },
    {
      "id": "no-reviewer-to-writer-direct",
      "from": "cc-code-reviewer",
      "to": "cc-code-writer",
      "reason": "审查结果应返回给原调用方处理，reviewer 不直接修改代码",
      "alternative": "code-reviewer 返回审查结果 → 原调用方（code-writer/work-mode）修复"
    },
    {
      "id": "no-codewriter-nesting",
      "from": "cc-code-writer",
