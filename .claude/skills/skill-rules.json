  "skills": {
    "cc-code-reviewer": {
      "type": "guardrail",
      "tier": "guardrail",
      "description": "执行九维度代码审查（安全/架构/事务/并发/数据完整性），支持advisory/unified/blocking三种模式。不修改代码、不实现功能。用于PR审查、代码质量检查",
      "promptTriggers": {
        "keywords": [
          "审查",
          "review",
          "检查代码",
          "审核",
          "code review",
          "PR",
          "pull request",
          "合并请求",
          "MR",
          "代码质量",
          "代码规范",
          "架构审查",
          "性能审查",
          "事务审查",
          "重构建议",
          "改进建议",
          "优化建议",
          "代码隐患",
          "代码风险",
          "安全漏洞",
          "看下这个",
          "是否合理",
          "事务问题",
          "锁问题",
          "N+1问题",
          "并发问题",
          "代码检视",
          "审一下",
          "审查门控",
          "九维度",
          "代码有没有",
          "代码有安全问题",
          "代码有没有安全"
