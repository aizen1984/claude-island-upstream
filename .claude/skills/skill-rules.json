      "skipConditions": {
        "keywords": [
          "修复bug",
          "修bug",
          "有bug",
          "个bug",
          "这个bug",
          "异常报错",
          "异常堆栈",
          "排查问题",
          "排查原因",
          "诊断",
          "定位问题",
          "NPE",
          "根因"
        ]
      },
      "fileTriggers": {
        "_implementedBy": "claude-context",
        "_note": "fileTriggers 供 Claude 自身上下文理解使用，非 Hook 运行时匹配。Claude 在读取/编辑匹配文件时参考此配置判断是否需要加载对应 Skill。",
        "pathPatterns": [
          "src/main/java/cn/caijiajia/**/*.java",
          "src/test/java/cn/caijiajia/**/*.java",
          "**/*.js",
          "**/*.ts",
          "**/*.py"
